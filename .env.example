# Copy to .env (never commit .env).

# --- Callyzer (Callyzer admin → Connectors → API & Webhook → API Config → Generate API Access Key)
CALLYZER_API_TOKEN=
CALLYZER_BASE_URL=https://api1.callyzer.co/api/v2.3
CALLYZER_INCLUDE_WHATSAPP_CALLS=false
# Leave people out / combine phones registered under different names ("Old=New;Old2=New2")
EXCLUDE_EMPLOYEES=
EMPLOYEE_ALIASES=

# --- WhatsApp group delivery (whatsapp-web.js). Schedule + target can also be switched on the status page.
WHATSAPP_TEST_GROUP=
WHATSAPP_LIVE_GROUP=
SEND_TO=test
SCHEDULE_ENABLED=false
# PORT=3000
REPORT_SLOTS=14:00,16:00,18:00,20:00
REPORT_DAYS=1,2,3,4,5,6,7
ADMIN_PASSWORD=
DATA_DIR=data

# Any long random string (used to hash phone numbers in memory)
HASH_SALT=
