# Copy to .env (never commit .env). See README.md.

# --- Callyzer (Callyzer admin → Connectors → API & Webhook → API Config → Generate API Access Key)
CALLYZER_API_TOKEN=
CALLYZER_BASE_URL=https://api1.callyzer.co/api/v2.3
CALLYZER_INCLUDE_WHATSAPP_CALLS=false
# Leave people out / combine phones registered under different names
EXCLUDE_EMPLOYEES=
EMPLOYEE_ALIASES=

# --- WhatsApp Cloud API (Meta) for the sending number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_MESSAGE_TYPE=template
WHATSAPP_TEMPLATE_NAME=call_report
WHATSAPP_TEMPLATE_LANGUAGE=en
# Comma-separated: phone numbers with country code (919876543210) or group:<GROUP_ID>
WHATSAPP_TEST_TARGETS=
WHATSAPP_LIVE_TARGETS=

# Any long random string (used to hash phone numbers in memory)
HASH_SALT=
