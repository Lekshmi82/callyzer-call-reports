{
  "name": "callyzer-call-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Callyzer call reports delivered to WhatsApp on an IST schedule",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create-admin": "node dist/cli/create-admin.js",
    "mock:callyzer": "tsx dev/mock-callyzer.ts",
    "mock:wati": "tsx dev/mock-wati.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
