{
  "name": "callyzer-call-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Callyzer call reports delivered to WhatsApp on an IST schedule",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mock:callyzer": "tsx dev/mock-callyzer.ts",
    "report": "tsx src/run-report.ts"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "pino": "^9.14.0",
    "playwright": "1.63.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
